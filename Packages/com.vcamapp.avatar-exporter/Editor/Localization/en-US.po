msgid "Report:NoTPose"
msgstr "The avatar could not be put into a T-pose, so it is exported in its current pose."

msgid "Report:NoColor"
msgstr "{0}: its materials draw no color, so it is not exported."

msgid "Report:StencilHidden"
msgstr "{0}: it draws only where other materials mark the screen with a stencil, so VRM apps that show the MToon material do not show it."

msgid "Report:DrawsOverAgain"
msgstr "{0}: {1} draw over the mesh again, which a VRM cannot hold, so they are not exported."

msgid "Report:FakeShadowHidden"
msgstr "{0}: VRM apps that show the MToon material do not show {1}."

msgid "Report:SpecialShader"
msgstr "{0}: VRM apps that show the MToon material show {1} as a plain MToon material."

msgid "Report:MissingShader"
msgstr "{0}: its shader is not installed in this project. Only its main texture and color are exported."

msgid "Report:NotLilToon"
msgstr "{0}: {1} is not lilToon. Only its main texture and color are exported."

msgid "Report:UnsupportedTexture"
msgstr "{0}: {1} is a {2} and is not exported."

msgid "Report:PhysBoneOverlap"
msgstr "{0}: {1} is already moved by another PhysBone and was skipped."

msgid "Report:UnsupportedCollider"
msgstr "{0}: the collider shape {1} is not supported and was skipped."

msgid "Report:FxExpressions"
msgstr "{0} facial animations of the FX layer were exported as expressions."

msgid "Report:FxMovesBones"
msgstr "{0} of them also move bones (ears, eye highlights and the like), which a VRM expression cannot. Only their shape keys are exported."

msgid "Report:NoVisemes"
msgstr "The avatar has no viseme shape keys, so its mouth does not move with the voice."

msgid "Report:VisemeMeshFound"
msgstr "The avatar descriptor names no mesh for the visemes, so {0}, which has them, is used."

msgid "Report:VisemeAnimations"
msgstr "The mouth shapes are the FX layer's animations the Viseme parameter plays on {0}."

msgid "Report:NoBlink"
msgstr "No blink shape key was found, so the avatar does not blink."

msgid "Report:SplitBlink"
msgstr "The shape key {0} on {1} closes both eyes, so it is split into one for each eye to let the avatar wink."

msgid "Report:ShapeKeyFound"
msgstr "The shape key {0} on {1} is used for {2}."

